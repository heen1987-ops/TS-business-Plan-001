   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">A breathtaking panoramic view of a city at sunset, featuring a winding highway with light trails, modern high-rise buildings, and silhouetted mountains in the background.</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Cityscape at Sunset with Highway and Mountains</rdf:li>
    </rdf:Alt>
   </dc:title>
