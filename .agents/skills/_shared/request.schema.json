{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CCK GROWTH 요청 입력",
  "type": "object",
  "required": [
    "schemaVersion",
    "context",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "const": "cck-growth-request/1"
    },
    "context": {
      "$ref": "#/$defs/context"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "PAST_PERFORMANCE",
              "CAPABILITY",
              "DEADLINE",
              "APPROVAL",
              "PROPOSED"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "baseline": {
      "type": "object",
      "required": [
        "id",
        "revision",
        "sourceIds",
        "approval"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "approval": {
          "$ref": "#/$defs/approval"
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "approval": {
            "$ref": "#/$defs/approval"
          }
        }
      }
    },
    "agencyProfile": {
      "type": "object",
      "description": "agency-profiles.json와 같은 구조. 새 기관 등록은 원문 근거를 별도 연결한다."
    }
  },
  "$defs": {
    "context": {
      "type": "object",
      "required": [
        "agencyId",
        "agencyName",
        "stage",
        "asOf",
        "agencyRole"
      ],
      "properties": {
        "agencyId": {
          "type": [
            "string",
            "null"
          ]
        },
        "agencyName": {
          "type": [
            "string",
            "null"
          ]
        },
        "agencyRole": {
          "enum": [
            "CONTRACTING_AUTHORITY",
            "MANAGING_AGENCY",
            "DEMAND_ORGANIZATION",
            "PERFORMER"
          ]
        },
        "projectId": {
          "type": [
            "string",
            "null"
          ]
        },
        "businessType": {
          "enum": [
            "INFORMATION_SYSTEM",
            "R_AND_D",
            "OTHER",
            "UNKNOWN"
          ]
        },
        "instrument": {
          "enum": [
            "PROCUREMENT",
            "AGREEMENT",
            "UNKNOWN"
          ]
        },
        "stage": {
          "enum": [
            "PROPOSAL",
            "PROJECT_MANAGEMENT",
            "AGENCY_ONBOARDING"
          ]
        },
        "noticeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "noticeRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "agreementId": {
          "type": [
            "string",
            "null"
          ]
        },
        "baselineRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "asOf": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "title",
        "kind",
        "version",
        "location",
        "verification",
        "scope"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "GUIDANCE",
            "NOTICE",
            "RFP",
            "PROPOSAL_DRAFT",
            "CONTRACT",
            "AGREEMENT",
            "APPROVED_PLAN",
            "APPROVAL_RECORD",
            "EVIDENCE"
          ]
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "enum": [
            "TEXT_REVIEWED",
            "METADATA_ONLY",
            "UNKNOWN"
          ]
        },
        "scope": {
          "enum": [
            "PROJECT",
            "AGENCY",
            "GENERAL",
            "HISTORICAL"
          ]
        },
        "context": {
          "type": "object",
          "properties": {
            "agencyId": {
              "type": [
                "string",
                "null"
              ]
            },
            "agencyName": {
              "type": [
                "string",
                "null"
              ]
            },
            "agencyRole": {
              "type": [
                "string",
                "null"
              ]
            },
            "projectId": {
              "type": [
                "string",
                "null"
              ]
            },
            "businessType": {
              "enum": [
                "INFORMATION_SYSTEM",
                "R_AND_D",
                "OTHER",
                "UNKNOWN"
              ]
            },
            "instrument": {
              "enum": [
                "PROCUREMENT",
                "AGREEMENT",
                "UNKNOWN"
              ]
            },
            "stage": {
              "enum": [
                "PROPOSAL",
                "PROJECT_MANAGEMENT",
                "AGENCY_ONBOARDING"
              ]
            },
            "noticeId": {
              "type": [
                "string",
                "null"
              ]
            },
            "noticeRevision": {
              "type": [
                "string",
                "null"
              ]
            },
            "agreementId": {
              "type": [
                "string",
                "null"
              ]
            },
            "baselineRevision": {
              "type": [
                "string",
                "null"
              ]
            },
            "asOf": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "contentHash": {
          "type": "string",
          "minLength": 1
        },
        "usage": {
          "type": "object",
          "required": [
            "context",
            "purpose",
            "permissionEvidenceRef"
          ],
          "properties": {
            "context": {
              "type": "object"
            },
            "purpose": {
              "const": "PAST_PERFORMANCE"
            },
            "permissionEvidenceRef": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "url"
          ]
        },
        {
          "required": [
            "path"
          ]
        }
      ]
    },
    "approval": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "EVIDENCE_REVIEWED",
            "CLAIMED",
            "UNKNOWN"
          ]
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "reviewedBy": {
          "type": "string",
          "minLength": 1
        },
        "reviewedAt": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "EVIDENCE_REVIEWED는 입력한 검토 주장. 실제 승인 사실을 프로그램이 검증하거나 생성하지 않는다."
    }
  }
}
